#pragma METAINFO("Manual Console Button Check", 1, 0, "NBA2K CV")
// Match with console_button_check.py only. No action on script startup.
// Each fresh rising-edge command taps A or X once for 100 ms.
uint8 magic_a;
uint8 magic_b;
uint8 command;
uint8 previous;

main {
    if(gcv_ready()) {
        gcv_read(0, &magic_a);
        gcv_read(1, &magic_b);
        gcv_read(2, &command);
        if(magic_a == 84 && magic_b == 49) {
            if(command != previous) {
                if(command == 1) {
                    printf("CONSOLE TEST: Titan issuing A for 100 ms");
                    combo_run(TapA);
                } else if(command == 2) {
                    printf("CONSOLE TEST: Titan issuing X for 100 ms");
                    combo_run(TapX);
                }
            }
            previous = command;
        } else {
            previous = 0;
        }
    }
}

combo TapA {
    set_val(BUTTON_16, 100);
    wait(100);
    set_val(BUTTON_16, 0);
    wait(100);
}

combo TapX {
    set_val(BUTTON_17, 100);
    wait(100);
    set_val(BUTTON_17, 0);
    wait(100);
}
