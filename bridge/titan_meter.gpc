#pragma METAINFO("NBA2K CV Meter Bridge", 3, 6, "NBA2K CV")
#include <PS4.gph>
// X jumpshots only: physical X hold, then one observed-green X release.
// Rhythm is deferred. No right-stick axes are rewritten.
// RT, movement and unrelated buttons are never rewritten.
// Release X before arming. PowerShell can test a timed X hold and release.
uint32 heartbeat_counter;
uint32 packet_seq;
uint32 incoming_seq;
uint32 event_id;
uint32 last_event;
uint32 fired_event;
uint16 packet_age = 1000;
uint16 ttl = 100;
uint16 delay_ms;
uint16 hold_ms;
uint16 active_delay;
uint16 active_hold;
uint16 phase_time;
int16 flick_value;
int16 active_value;
uint8 phase;
bool armed;
bool green;
bool fired;
bool observed;
bool shot_active;
bool blocked = TRUE;
bool holding;
uint8 shot_mode;
uint8 incoming_mode;
uint8 test_command;
uint8 test_previous;
uint8 test_button;
uint32 test_counter;
bool manual_packet;
bool release_x;
bool manual_hold_x;
bool ai_hold_x;
bool ai_timeout;
uint16 manual_hold_age;
uint8 gate_reason;
uint16 gate_word;

main {
    combo_run(Heartbeat);
    if(packet_age < 1000) packet_age += elapsed_time();
    manual_packet = FALSE;
    if(gcv_ready()) {
        if(cv_byte(0) == 84 && cv_byte(1) == 49) manual_packet = TRUE;
    }
    if(manual_packet) {
        test_command = cv_byte(2);
        if(test_command != test_previous && test_command == 5) {
            // Explicit app request: start one AI-timed X hold only after arming.
            if(armed && shot_mode == 1 && packet_age <= 250 && !blocked
                && !manual_hold_x && !release_x && !get_actual(BUTTON_17)) {
                test_counter++;
                test_button = 5;
                manual_hold_x = TRUE;
                ai_hold_x = TRUE;
                ai_timeout = FALSE;
                manual_hold_age = 0;
                fired = FALSE;
                shot_active = TRUE;
                last_event = event_id;
            }
        } else if(test_command != 0 && test_command != 5) {
            // Manual diagnostics disarm AI. Neutral callbacks must not cancel
            // a hold that is waiting for an AI event.
            armed = FALSE;
            phase = 0;
            blocked = TRUE;
            shot_active = FALSE;
            if(ai_hold_x) {
                manual_hold_x = FALSE;
                ai_hold_x = FALSE;
                release_x = TRUE;
            }
            if(test_command != test_previous) {
                if(test_command == 1) {
                    test_counter++;
                    test_button = 1;
                    combo_run(ConsoleTapA);
                } else if(test_command == 2) {
                    test_counter++;
                    test_button = 2;
                    combo_run(ConsoleTapX);
                } else if(test_command == 3) {
                    test_counter++;
                    test_button = 3;
                    manual_hold_x = FALSE;
                    release_x = TRUE;
                } else if(test_command == 4) {
                    test_counter++;
                    test_button = 4;
                    manual_hold_x = TRUE;
                    manual_hold_age = 0;
                    release_x = FALSE;
                }
            }
        }
        test_previous = test_command;
    } else {
        if(gcv_ready()) test_previous = 0;
        if(gcv_ready()) {
            if(cv_byte(0) == 0 && cv_byte(1) == 77 && cv_byte(2) == 3) {
                incoming_seq = ((uint32)cv_byte(19) << 24) | ((uint32)cv_byte(20) << 16)
                             | ((uint32)cv_byte(21) << 8) | (uint32)cv_byte(22);
                if(incoming_seq != packet_seq) {
                    packet_seq = incoming_seq;
                    packet_age = 0;
                    incoming_mode = cv_byte(25);
                    if(incoming_mode != shot_mode) blocked = TRUE;
                    shot_mode = incoming_mode;
                    armed = cv_byte(4) == 1;
                    observed = cv_byte(3) == 1;
                    green = cv_byte(3) == 1 && cv_byte(5) == 1;
                    flick_value = -100;
                    if(cv_byte(6) == 1) flick_value = 100;
                    delay_ms = ((uint16)cv_byte(7) << 8) | (uint16)cv_byte(8);
                    hold_ms = ((uint16)cv_byte(9) << 8) | (uint16)cv_byte(10);
                    event_id = ((uint32)cv_byte(11) << 24) | ((uint32)cv_byte(12) << 16)
                             | ((uint32)cv_byte(13) << 8) | (uint32)cv_byte(14);
                    ttl = ((uint16)cv_byte(23) << 8) | (uint16)cv_byte(24);
                    if(shot_mode != 1 || delay_ms > 250 || hold_ms < 10 || hold_ms > 500 || ttl < 25 || ttl > 250) armed = FALSE;
                }
            } else { armed = FALSE; }
        }
        // Raw physical X, independent of any prior script output override.
        holding = get_actual(BUTTON_17) > 0.0 || ai_hold_x;

        // Explicit disarm or link timeout cancels new automated actions.
        // Disarm, 250 ms link loss, mode change require a release.
        // Observation TTL gates NEW events; it is not the callback watchdog.
        if(!armed || packet_age > 250) {
            phase = 0;
            shot_active = FALSE;
            blocked = TRUE;
            fired = TRUE;
            last_event = event_id;
        } else if(blocked) {
            phase = 0;
            shot_active = FALSE;
            last_event = event_id;
            if(!get_actual(BUTTON_17)) {
                blocked = FALSE;
                fired = FALSE;
            }
        } else {
            // Physical X passes through until a fresh observed green event.
            // Suppress it until physical release; never synthesize a second press.
            if(!holding) {
                shot_active = FALSE;
                fired = FALSE;
                last_event = event_id;
            } else {
                if(!fired) shot_active = TRUE;
                if(shot_active && packet_age <= ttl && green && event_id != 0 && event_id != last_event && !fired) {
                    fired = TRUE;
                    last_event = event_id;
                    fired_event = event_id;
                    manual_hold_x = FALSE;
                    ai_hold_x = FALSE;
                    release_x = TRUE;
                }
    
            }
        }
    }
    if(ai_hold_x && (!armed || packet_age > 250)) {
        manual_hold_x = FALSE;
        ai_hold_x = FALSE;
        release_x = TRUE;
    }
    // Explicit manual hold lasts until RELEASE_X, with a device-side limit
    // if PowerShell, GCV or the app stops before the release is delivered.
    if(manual_hold_x) {
        manual_hold_age += elapsed_time();
        if(manual_hold_age >= 2500) {
            if(ai_hold_x) ai_timeout = TRUE;
            ai_hold_x = FALSE;
            manual_hold_x = FALSE;
            release_x = TRUE;
        } else set_val(BUTTON_17, 100);
    }
    // Shared release operation: synthetic holds and physical X are both released.
    if(release_x) {
        set_val(BUTTON_17, 0);
        if(!get_actual(BUTTON_17)) release_x = FALSE;
    }
    gate_reason = 0;
    if(!armed) gate_reason = 1;
    else if(packet_age > 250) gate_reason = 2;
    else if(blocked) gate_reason = 4;
    else if(!holding && phase == 0) gate_reason = 5;
    else if(release_x || fired) gate_reason = 8;
    else if(!green) gate_reason = 6;
    else if(packet_age > ttl) gate_reason = 7;
    gate_word = gate_reason + 16 + 256 + 1024 + 2048; // Timing + release + hold capabilities.
    if(get_actual(BUTTON_17) > 0.0) gate_word += 512;
    if(ai_hold_x) gate_word += 4096;
    if(ai_timeout) gate_word += 8192;
}

combo Heartbeat {
    wait(500);
    printf("GCMD:ComputerVision.PY:T2CV:%d:%d:%d:%d:3:%d:%d:%d", heartbeat_counter++, packet_seq, fired_event, mslot_get(), test_counter, test_button, gate_word);
}

// GPC2 gcv_read writes into a typed destination; it does not return a byte.
uint8 cv_byte(uint8 offset) {
    uint8 value;
    gcv_read(offset, &value);
    return value;
}

// Same one-shot combinations as the successful console-button test.
combo ConsoleTapA {
    set_val(BUTTON_16, 100);
    wait(100);
    set_val(BUTTON_16, 0);
    wait(100);
}
combo ConsoleTapX {
    set_val(BUTTON_17, 100);
    wait(100);
    set_val(BUTTON_17, 0);
    wait(100);
}
